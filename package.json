{
  "name": "recalbox-os-web",
  "productName": "Recalbox OS Web",
  "version": "2.2.1",
  "description": "Standalone multi-system retro gaming desktop app (NES, SNES, N64, GB, GBA, Genesis, PSX, Arcade, DOS & more). All emulator cores bundled — runs 100% offline.",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/download-cores.js --soft --quiet && node scripts/download-roms.js --soft --quiet && electron .",
    "cores": "node scripts/download-cores.js",
    "cores:check": "node scripts/download-cores.js --check",
    "roms": "node scripts/download-roms.js",
    "roms:check": "node scripts/download-roms.js --check",
    "predist": "node scripts/download-cores.js --check && node scripts/download-roms.js --check",
    "dist": "electron-builder --publish never",
    "arcade-db": "node scripts/build-arcade-db.js"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.recalbox.web",
    "productName": "Recalbox OS Web",
    "artifactName": "RecalboxOSWeb-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "www/**/*",
      "!www/data/cores/*.part",
      "!www/img/{screenshot,library,control-center,settings,core-info,in-action}.png",
      "!www/img/free-library.jpg",
      "!www/img/banner.svg"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "RecalboxOSWeb-${version}-win-${arch}-setup.${ext}",
      "shortcutName": "Recalbox OS Web"
    },
    "portable": {
      "artifactName": "RecalboxOSWeb-${version}-win-${arch}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icons",
      "synopsis": "Standalone multi-system retro gaming app",
      "desktop": {
        "Name": "Recalbox OS Web",
        "Comment": "26 retro systems, every emulator bundled, offline",
        "Categories": "Game;Emulator;"
      }
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.games"
    },
    "icon": "build/icon.png",
    "asarUnpack": [
      "www/data/cores/**"
    ],
    "compression": "normal"
  }
}
