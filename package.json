{
  "name": "recalbox-os-web",
  "productName": "Recalbox OS Web",
  "version": "2.1.0",
  "description": "Standalone multi-system retro gaming desktop app (NES, SNES, N64, GB, GBA, Genesis, PSX, Arcade, DOS & more). All emulator cores bundled \u2014 runs 100% offline.",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/download-cores.js --soft --quiet && electron .",
    "cores": "node scripts/download-cores.js",
    "cores:check": "node scripts/download-cores.js --check",
    "predist": "node scripts/download-cores.js --check",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.recalbox.web",
    "productName": "Recalbox OS Web",
    "files": [
      "main.js",
      "www/**/*",
      "!www/data/cores/*.part"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "icon": "build/icon.png",
    "asarUnpack": [
      "www/data/cores/**"
    ],
    "compression": "normal"
  }
}
